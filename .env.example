# ==========================================
# LedgerFlow Environment Variables Example
# Copy this file to .env.local for local development.
# ==========================================

# ------------------------------------------
# Database Configuration (REQUIRED)
# ------------------------------------------
# PostgreSQL database connection string (Supabase Postgres or local Postgres instance).
DATABASE_URL="postgresql://postgres:password@localhost:5432/ledgerflow"

# ------------------------------------------
# Better Auth Configuration
# ------------------------------------------
# Secret key used for signing cookies, sessions, and tokens. Must be at least 32 characters. (REQUIRED)
# Generate a secret: `openssl rand -hex 32` or `npx better-auth secret`
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"

# Base URL of your application auth server. (REQUIRED)
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of allowed origins for cross-origin requests. (OPTIONAL)
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://app.yourdomain.com"

# ------------------------------------------
# OAuth Providers (OPTIONAL)
# ------------------------------------------
# Google OAuth Client Credentials for social sign-in.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------
# Cron & Maintenance Endpoints (OPTIONAL)
# ------------------------------------------
# Secret token required in the Authorization header (`Bearer <CRON_SECRET>`) for trigger endpoints like /api/cron/recurring.
CRON_SECRET="your-cron-secret-bearer-token"

# ------------------------------------------
# Client / Public Environment Variables (NEXT_PUBLIC_)
# Exposed to the browser bundle
# ------------------------------------------
# Canonical website URL for metadata, SEO, and absolute redirects. (OPTIONAL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage / Remote Image Domain configuration. (OPTIONAL)
# NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
